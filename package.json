{
  "name": "hono-bun-demo",
  "scripts": {
    "dev": "concurrently \"bun run server\" \"bun run client\"",
    "client": "cd client && bun run dev",
    "server": "bun run --hot server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run ./scripts/seed-local-db.script.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-seed": "^0.3.1"
  }
}
